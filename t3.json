{
  "$schema": "https://t3.codes/schema/t3.json",
  "iconPath": "public/favicon.svg",
  "worktreeSubmodules": "none",
  "scripts": [
    {
      "name": "Setup Worktree",
      "command": "bash scripts/setup-worktree.sh",
      "icon": "configure",
      "runOnWorktreeCreate": true,
      "async": false
    },
    {
      "name": "Clean Worktree",
      "command": "bash scripts/clean-worktree.sh",
      "icon": "configure",
      "runOnSettle": true
    },
    {
      "name": "Dev",
      "command": "pnpm dev",
      "icon": "play",
      "stopOnSettle": true,
      "previewUrl": "http://localhost:3000"
    },
    { "name": "Test", "command": "pnpm test", "icon": "test" },
    { "name": "Typecheck", "command": "pnpm typecheck", "icon": "lint" },
    { "name": "Check", "command": "pnpm check", "icon": "lint" },
    { "name": "Build", "command": "pnpm build", "icon": "build" }
  ]
}
